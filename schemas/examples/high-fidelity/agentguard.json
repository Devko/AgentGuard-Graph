{
  "schema_version": "0.1",
  "agents": [
    {
      "id": "release-agent",
      "name": "Release Agent",
      "owner": "platform-release",
      "runtime": "langgraph",
      "environment": "production",
      "autonomy": "autonomous",
      "input_sources": ["slack_release_request"],
      "tools": ["github.merge_pr", "kubernetes.apply_manifest"],
      "identities": ["github:release-app", "kubernetes:release-runner"],
      "memory": ["release-memory"],
      "approval_policy": "release-policy",
      "labels": {
        "business_unit": "platform",
        "criticality": "critical"
      }
    }
  ],
  "input_sources": [
    {
      "id": "slack_release_request",
      "trust": "mixed",
      "description": "Release request from an internal Slack channel"
    }
  ],
  "memory_stores": [
    {
      "id": "release-memory",
      "persistence": "session",
      "retention_policy": "delete_after_24h",
      "data_classes": ["deployment_metadata"]
    }
  ]
}
