{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.dev/schemas/data-catalog.schema.json",
  "title": "Data catalog evidence",
  "type": "object",
  "required": ["schema_version", "data_sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "data_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/data_source"}
    }
  },
  "$defs": {
    "data_source": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "target_system": {"type": "string"},
        "owner": {"type": "string"},
        "data_classes": {"type": "array", "items": {"type": "string"}, "default": []},
        "classification_labels": {"type": "array", "items": {"type": "string"}, "default": []},
        "fields": {"type": "array", "default": []},
        "source_kind": {"type": "string"},
        "source_evidence": {"type": "string"},
        "sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "medium", "high", "critical", "unknown"],
          "default": "unknown"
        },
        "persistence": {"type": "string"}
      }
    }
  }
}
